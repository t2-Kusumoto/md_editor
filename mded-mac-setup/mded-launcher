#!/bin/bash
# ==============================================================================
# MD Editor GUI Launcher for macOS (.app bundle)
# ==============================================================================

# Ensure standard system and user binary paths are in PATH
export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

TARGET_BIN="$HOME/.local/bin/mded"

if [ ! -x "$TARGET_BIN" ]; then
    if command -v osascript > /dev/null 2>&1; then
        osascript -e 'display alert "MD Editor Error" message "Executable not found at ~/.local/bin/mded. Please run setup.sh again."'
    else
        echo "Error: Executable not found at $TARGET_BIN" >&2
    fi
    exit 1
fi

if [ $# -gt 0 ]; then
    exec "$TARGET_BIN" "$1"
else
    exec "$TARGET_BIN"
fi
