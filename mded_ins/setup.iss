; Script generated by the Inno Setup Script Wizard, then modified for PATH addition.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "Md_Editor"
; GitHub Actions 等のコマンドライン引数 (/DMyAppVersion=...) から上書き可能にする
#ifndef MyAppVersion
#define MyAppVersion "1.0.3"
#endif
#define MyAppPublisher "t2-kusumoto"
#define MyAppURL "https://github.com/t2-Kusumoto/md_editor"
#define MyAppExeName "mded.exe"
#define MyAppIconName "mded_icon.ico"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".md"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
AppId={{317D7389-D8B1-4AE9-9167-6F9DD930D89D}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={localappdata}\Programs\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
; 出力ファイル名を setup_mded.exe に統一し、同階層に出力
OutputBaseFilename=setup_mded
OutputDir=.
; 相対パス指定に変更（ローカルでもCIでも動作）
SetupIconFile={#MyAppIconName}
SolidCompression=yes
WizardStyle=classic
ChangesEnvironment=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "addtopath"; Description: "Add {#MyAppName} to the user PATH"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkedonce

[Files]
; 相対パス指定に変更
Source: "{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppIconName}"; DestDir: "{app}"; Flags: ignoreversion

[Registry]
; .md ファイルの関連付け
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppIconName}"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
; ユーザー環境変数 PATH への追加
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"; Check: NeedsAddPath(ExpandConstant('{app}')); Tasks: addtopath

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppIconName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\{#MyAppIconName}"

[Code]
function NeedsAddPath(Param: string): boolean;
var
  OrigPath: string;
begin
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', OrigPath) then
  begin
    Result := True;
    exit;
  end;
  Result := (Pos(';' + UpperCase(Param) + ';', ';' + UpperCase(OrigPath) + ';') = 0) and
            (Pos(';' + UpperCase(Param) + '\;', ';' + UpperCase(OrigPath) + ';') = 0);
end;

procedure RemoveFromPath(Path: string);
var
  Paths: string;
  UpperPaths: string;
  P: Integer;
  ToRemove: string;
begin
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', Paths) then
    exit;

  UpperPaths := ';' + UpperCase(Paths) + ';';

  // 通常のケース（末尾 \ なし）
  ToRemove := ';' + UpperCase(Path) + ';';
  P := Pos(ToRemove, UpperPaths);

  if P = 0 then
  begin
    // 末尾 \ 付きのケース
    ToRemove := ';' + UpperCase(Path) + '\;';
    P := Pos(ToRemove, UpperPaths);
  end;

  if P > 0 then
  begin
    // UpperPaths の先頭に付けた ; の分を補正
    if P > 1 then
      P := P - 1;

    // ToRemove の先頭の ; を除いた長さを削除
    Delete(Paths, P, Length(ToRemove) - 1);

    // 連続する ;; を整理
    while Pos(';;', Paths) > 0 do
      StringChangeEx(Paths, ';;', ';', True);

    // 先頭・末尾の ; を除去
    if (Length(Paths) > 0) and (Paths[1] = ';') then
      Delete(Paths, 1, 1);
    if (Length(Paths) > 0) and (Paths[Length(Paths)] = ';') then
      Delete(Paths, Length(Paths), 1);

    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', Paths);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    RemoveFromPath(ExpandConstant('{app}'));
end;
